<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Obentunes</AssemblyName>
    <BepInExPluginGuid>bdopz.obentunes</BepInExPluginGuid>
    <Product>Obentunes</Product>
    <Version>1.1.0</Version>

    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json
    </RestoreAdditionalProjectSources>

    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Obenseuer</GameDir>
    <ManagedDir>$(GameDir)\Obenseuer_Data\Managed</ManagedDir>
    <BepInExDir>$(GameDir)\BepInEx\core</BepInExDir>
    <PluginsDir>$(GameDir)\BepInEx\plugins</PluginsDir>
    <ScriptsDir>$(GameDir)\BepInEx\scripts</ScriptsDir>
    <BuildDir>$(PluginsDir)\$(AssemblyName)</BuildDir>

    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <DebugType>embedded</DebugType>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <NoStdLib>true</NoStdLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <FrameworkPathOverride>$(ManagedDir)</FrameworkPathOverride>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <Reference>
      <Private>false</Private>
    </Reference>
  </ItemDefinitionGroup>

  <Target Name="CopyToGame" AfterTargets="Build">
    <ItemGroup>
      <ResFiles Include="$(MSBuildProjectDirectory)\res\**\*.*"/>
    </ItemGroup>
    
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ScriptsDir)"/>
    <Copy SourceFiles="@(ResFiles)" DestinationFolder="$(BuildDir)\res" SkipUnchangedFiles="true"/>
    <MakeDir Directories="$(BuildDir)\custom"/>
  </Target>

  <ItemGroup>
    <Reference Include="$(ManagedDir)\mscorlib.dll"/>
    <Reference Include="$(ManagedDir)\netstandard.dll"/>
    <Reference Include="$(ManagedDir)\System.dll"/>
    <Reference Include="$(ManagedDir)\System.Core.dll"/>

    <Reference Include="$(ManagedDir)\UnityEngine.dll"/>
    <Reference Include="$(ManagedDir)\UnityEngine.CoreModule.dll"/>
    <Reference Include="$(ManagedDir)\Unity.InputSystem.dll"/>
    <Reference Include="$(ManagedDir)\UnityEngine.IMGUIModule.dll"/>
    <Reference Include="$(ManagedDir)\UnityEngine.AudioModule.dll"/>
    <Reference Include="$(ManagedDir)\UnityEngine.UnityWebRequestModule.dll"/>
    <Reference Include="$(ManagedDir)\UnityEngine.UnityWebRequestAudioModule.dll"/>
    <Reference Include="$(ManagedDir)\UnityEngine.TextRenderingModule.dll"/>
    <Reference Include="$(ManagedDir)\Newtonsoft.Json.dll"/>

    <Reference Include="$(ManagedDir)\Assembly-CSharp.dll" Publicize="true"/>
    <Reference Include="$(ManagedDir)\Assembly-CSharp-firstpass.dll" Publicize="true"/>

    <Reference Include="$(BepInExDir)\BepInEx.dll"/>
    <Reference Include="$(BepInExDir)\0Harmony.dll"/>
    <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all"/>
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.8" PrivateAssets="all"/>
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0"/>

    <PackageReference Include="Costura.Fody" Version="6.2.0" PrivateAssets="all" />
    <PackageReference Include="AssetsTools.NET" Version="3.0.5" />
    <PackageReference Include="Fmod5Sharp" Version="3.1.0" />
  </ItemGroup>

</Project>
